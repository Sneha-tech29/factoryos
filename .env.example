# FactoryOS Environment Configuration
# Copy this file to .env.local for local overrides

# Application Environment (development | production | test)
NODE_ENV=production

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server Port
PORT=3000

# SQLite Database Location
# On serverless / containerized VPS (e.g. Docker, Railway, Render), mount a persistent volume
# and set DATABASE_PATH to that directory (e.g. /var/data/factoryos.sqlite)
DATABASE_PATH=

# Session Expiry (in milliseconds, default 7 days = 604800000)
SESSION_MAX_AGE_MS=604800000
