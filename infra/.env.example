# FactoryOS Environment Configuration Template
# Copy to .env for local development

APP_ENV=development
SECRET_KEY=change-this-in-production-to-a-secure-random-key
DEFAULT_FACTORY_ID=fac_sample_01

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://factoryos_user:factoryos_dev_password@localhost:5432/factoryos_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# AI Provider (Optional in dev; fallback mode active by default)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
